# Copy to .env and fill every value. Never commit .env.

# Your domain (DNS A record must point at this server). Use "localhost" to try the stack locally.
DOMAIN=shop.example.com

# Generate with:  openssl rand -base64 32
POSTGRES_PASSWORD=
# Generate with:  openssl rand -base64 48
JWT_SECRET=

# First admin account (created on the first start). Pick a strong password, then change it after logging in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Paystack secret key: sk_test_... while testing, sk_live_... when you go live
PAYSTACK_SECRET_KEY=

# Optional but recommended: real emails through https://resend.com
RESEND_API_KEY=
MAIL_FROM=ShopEase <no-reply@example.com>

# Set to true only if you want /swagger-ui.html reachable in production
SWAGGER_ENABLED=false

# Shown on the Terms / Privacy pages and in the footer (rebuild the web container after changing: docker compose up -d --build web)
VITE_COMPANY_NAME=ShopEase
VITE_SUPPORT_EMAIL=support@example.com
VITE_COMPANY_ADDRESS=
# Set to true once a lawyer has reviewed the legal text (removes the "template" notice)
VITE_LEGAL_REVIEWED=false
