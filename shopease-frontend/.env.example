# Leave empty in development (Vite proxies /api to http://localhost:8080)
VITE_API_URL=
# Currency shown in prices (the backend sends Paystack amounts in NGN)
VITE_CURRENCY=NGN

# Shown in the Terms, Privacy Policy and footer
VITE_COMPANY_NAME=ShopEase
VITE_SUPPORT_EMAIL=support@your-domain.com
VITE_COMPANY_ADDRESS=
# Set to true after a lawyer has reviewed the legal text (hides the "template" notice)
VITE_LEGAL_REVIEWED=false
